feature streaming-telemetry vrf management
!
telemetry maximum-subscribe-paths 140
!
service password-encryption
!
logging level nsm 4
logging level cmm 4
!
!
snmp-server enable traps link linkDown
snmp-server enable traps link linkUp
!
hardware-profile filter ingress-ipv4-ext enable
hardware-profile statistics voq-full-color enable
hardware-profile statistics cfm-ccm enable
!
bfd interval 50 minrx 50 multiplier 3
!
qos enable
qos statistics
!
mpls l2vpn-stitching
mpls ftn-ecmp ldp
!
mpls vpls test 100
 vpls-mtu 1600
 signaling ldp
  vpls-type vlan
  vpls-peer 10.10.10.5
 exit-signaling
 exit-vpls
!
hostname PE4
feature pbr
tfo Disable
errdisable cause stp-bpdu-guard
feature dns relay
ip dns relay
ipv6 dns relay
feature rsyslog
logging remote server 172.16.10.17 5 port 1514 vrf management
lldp run
lldp tlv-select basic-mgmt port-description
lldp tlv-select basic-mgmt system-name
lldp tlv-select basic-mgmt system-capabilities
lldp tlv-select basic-mgmt system-description
lldp tlv-select basic-mgmt management-address
lldp notification-interval 1000
fault-management enable
!
ip access-list Anti-Spoofing
 remark 1 Anti-Spoofing
 10 deny any 0.0.0.0 0.255.255.255 any
 20 deny any 10.0.0.0 0.255.255.255 any
 30 deny any 100.64.0.0 0.63.255.255 any
ip access-list PBR-test
 5 permit icmp host 2.2.2.2 host 8.8.8.8
 10 permit any host 10.233.128.108 host 10.233.128.97
ip access-list PBR-test1
 10 permit icmp host 2.2.2.2 host 2.2.2.1
 30 deny icmp any any
!
evpn mpls enable
!
evpn mpls irb
!
evpn irb-forwarding anycast-gateway-mac 0000.0000.0004
!
ip vrf management
!
evpn mpls vtep-ip-global 10.10.10.4
!
route-map AIGP permit 10
 set aigp-metric igp-metric
!
route-map PBR-test permit 10
 match ip address PBR-test
 set ip next-hop 10.233.128.111
!
route-map PBR-test1 permit 10
 match ip address PBR-test1
 set ip next-hop 10.233.128.111
!
