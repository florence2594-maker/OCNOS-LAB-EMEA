
!
hostname PE2
lldp tlv-select basic-mgmt port-description
lldp tlv-select basic-mgmt system-name
lldp tlv-select basic-mgmt system-capabilities
lldp tlv-select basic-mgmt system-description
lldp tlv-select basic-mgmt management-address
!
evpn mpls enable
evpn mpls vtep-ip-global 10.10.10.2
!
ip vrf IPVRF_1
 router-id 10.10.10.2
 rd 10.10.10.2:100
 route-target both 2422:100
!
 mac vrf EVPN_1001
 rd 10.10.10.2:1001
 route-target both 2422:1001
!
evpn mpls id 1001
host-reachability-protocol evpn-bgp EVPN_1001
!
!
interface loopback1
 ip address 10.10.10.2/32
 ipv6 address fec0:2422::10:10:10:2/128
 prefix-sid index 22
 ip router isis 2422
 ipv6 router isis 2422
!
interface xe13.100
 encapsulation dot1q 100
 ip vrf forwarding IP_VRF
 ip address 100.66.2.1/30
!
interface xe13.1001 switchport
encapsulation dot1q 1001
access-if-evpn
map vpn-id 1001
!
interface cd1
 ip address 10.10.23.1/30
 ipv6 address 2603::9/127
 label-switching
 isis network point-to-point
 ip router isis 2422
 ipv6 router isis 2422
 lldp-agent
  set lldp enable txrx
  dcbx enable
  exit
!
interface cd0
 ip address 10.10.24.1/30
 ipv6 address 2603::2/127
 label-switching
 isis network point-to-point
 ip router isis 2422
 ipv6 router isis 2422
 lldp-agent
  set lldp enable txrx
  dcbx enable
  exit
!
!
router isis 2422
 is-type level-1
 metric-style wide level-1
 mpls traffic-eng level-1
 dynamic-hostname
 fast-reroute per-prefix level-1 proto ipv4 all
 bfd all-interfaces
 net 49.2422.0000.0000.0002.00
 isis segment-routing global block 16000 23999
 segment-routing mpls
!
router bgp 2422
 bgp router-id 10.10.10.2
 no bgp inbound-route-filter
 neighbor 10.10.10.3 remote-as 2422
 neighbor 10.10.10.3 update-source loopback1
 neighbor 10.10.10.4 remote-as 2422
 neighbor 10.10.10.4 update-source loopback1
 neighbor 10.10.10.5 remote-as 2422
 neighbor 10.10.10.5 update-source loopback1
 neighbor fec0:2422::10:10:10:3 remote-as 2422
 neighbor fec0:2422::10:10:10:3 update-source loopback1
 neighbor fec0:2422::10:10:10:4 remote-as 2422
 neighbor fec0:2422::10:10:10:4 update-source loopback1
 neighbor fec0:2422::10:10:10:5 remote-as 2422
 neighbor fec0:2422::10:10:10:5 update-source loopback1
 !
 address-family ipv4 unicast
 neighbor 10.10.10.3 activate
 neighbor 10.10.10.3 next-hop-self
 neighbor 10.10.10.4 activate
 neighbor 10.10.10.4 next-hop-self
 neighbor 10.10.10.5 activate
 neighbor 10.10.10.5 next-hop-self
 exit-address-family
 !
 address-family vpnv4 unicast
 neighbor 10.10.10.3 activate
 neighbor 10.10.10.3 next-hop-self
 neighbor 10.10.10.4 activate
 neighbor 10.10.10.4 next-hop-self
 neighbor 10.10.10.5 activate
 neighbor 10.10.10.5 next-hop-self
 exit-address-family
 !
address-family l2vpn evpn
  neighbor 10.10.10.3 activate
  neighbor 10.10.10.3 next-hop-self
  neighbor 10.10.10.4 activate
  neighbor 10.10.10.4 next-hop-self
  neighbor 10.10.10.5 activate
  neighbor 10.10.10.5 next-hop-self
 exit-address-family
 !
 address-family ipv6 unicast
 neighbor fec0:2422::10:10:10:3 activate
 neighbor fec0:2422::10:10:10:3 next-hop-self
 neighbor fec0:2422::10:10:10:4 activate
 neighbor fec0:2422::10:10:10:4 next-hop-self
 neighbor fec0:2422::10:10:10:5 activate
 neighbor fec0:2422::10:10:10:5 next-hop-self
 exit-address-family
 !
 address-family ipv4 vrf IPVRF_1
 neighbor 100.66.2.2 remote-as 700
 neighbor 100.66.2.2 activate
 exit-address-family
 !
 exit
